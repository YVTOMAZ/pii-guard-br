# Exemplo de configuração. Copie para .env SOMENTE se sua ferramenta carregar
# esse formato; o plugin não lê .env sozinho. Nunca commitar .env real.
# Precedência: CLAUDE_PLUGIN_OPTION_<CHAVE> > config.json > padrão.

# Onde config.json é lido (padrão ~/.config -> ~/.config/pii-tokens/config.json)
# XDG_CONFIG_HOME=

# Diretório do cofre (padrão ~/.local/share/pii-tokens)
# CLAUDE_PLUGIN_OPTION_DATA_DIR=

# Nome do serviço no keyring (padrão pii-tokens)
# CLAUDE_PLUGIN_OPTION_KEYRING_SERVICE=

# Domínios de email extras não mascarados: lista JSON OU separada por vírgula
# CLAUDE_PLUGIN_OPTION_ALLOWED_EMAIL_DOMAINS=empresa.example,outra.example

# Backend de keyring só para testes/CI sem keyring do sistema
# (PlaintextKeyring grava em texto claro: não usar com dados reais)
# PYTHON_KEYRING_BACKEND=keyrings.alt.file.PlaintextKeyring

# Modelo usado pelo pii-selfcheck (padrão haiku)
# PII_SELFCHECK_MODEL=
