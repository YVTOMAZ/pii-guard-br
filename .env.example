# Copie para .env apenas se sua ferramenta carregar esse formato.
# Nunca commitar .env com valores reais.

# Diretório de dados do cofre (opcional; padrão ~/.local/share/pii-tokens)
# PII_DATA_DIR=

# Serviço do keyring (opcional; padrão pii-tokens)
# PII_KEYRING_SERVICE=

# Domínios de email liberados (lista JSON), separados por vírgula
# PII_ALLOWED_EMAIL_DOMAINS=["acme.example"]

# Backend de keyring para ambientes sem keyring do sistema (CI/testes)
# PYTHON_KEYRING_BACKEND=keyrings.alt.file.PlaintextKeyring

# XDG config (onde config.json é lido)
# XDG_CONFIG_HOME=~/.config
